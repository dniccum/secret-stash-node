{
  "name": "@secret-stash/cli",
  "version": "0.1.0",
  "description": "Sync zero-knowledge encrypted .env variables across your team from the command line or Node.js, using the SecretStash secrets manager.",
  "keywords": [
    "secret-stash",
    "secretstash",
    "env",
    "dotenv",
    "environment-variables",
    "secrets",
    "secrets-management",
    "encryption",
    "cli"
  ],
  "homepage": "https://secretstash.cloud",
  "bugs": {
    "url": "https://github.com/dniccum/secret-stash-node/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "secret-stash": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' '__tests__/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dniccum/secret-stash-node.git"
  },
  "author": "Doug Niccum <doug@dniccumdesign.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
